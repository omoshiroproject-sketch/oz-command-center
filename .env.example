# Copy to an ignored development-only file. Leave every Secret blank until the
# corresponding account is configured. Never paste populated values into Git,
# documentation, logs, issue trackers, or chat.

# Owner authentication (development)
OZ_ALLOWED_EMAIL=
SUPABASE_URL=
# Preferred Supabase key names. Legacy anon/service-role names remain supported
# only during the development transition.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase CLI local Google provider (development)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Edge Function server-only values
SUPABASE_SERVICE_ROLE_KEY=
OZ_EXTERNAL_WORKER_URL=
OZ_EXTERNAL_WORKER_AUTHORIZATION=

# LIVE OZ server-only values
OPENAI_API_KEY=
OZ_REALTIME_MODEL=gpt-realtime-2.1
OZ_VOICE=cedar
OZ_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OZ_SAFETY_IDENTIFIER_SALT=

# Monitoring. Do not attach request bodies or personal data.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Local MCP Inspector boundary. Generate and set values manually; never commit.
OZ_MCP_LOCAL_INSPECTOR_TOKEN=
OZ_MCP_LOCAL_OWNER_ID=

# Production remote MCP OAuth is intentionally not configured in Phase 1B.
OZ_MCP_SERVER_URL=
OZ_MCP_RESOURCE_URL=
OZ_MCP_AUTHORIZATION_SERVER=

# Reserved server-side, read-only connector boundaries. No connector is called
# until its own account setup and least-privilege scope review is complete.
OZ_GOOGLE_CALENDAR_READ_TOKEN=
OZ_GMAIL_READ_TOKEN=
OZ_GOOGLE_DRIVE_READ_TOKEN=
OZ_SLACK_READ_TOKEN=
OZ_CHATWORK_READ_TOKEN=
OZ_SNS_ANALYTICS_READ_TOKEN=
OZ_SALES_DATA_READ_TOKEN=
OZ_ZOOM_READ_TOKEN=
OZ_LINE_READ_TOKEN=
OZ_SMS_READ_TOKEN=
OZ_GOOGLE_TASKS_READ_TOKEN=
OPENAI_GOOGLE_CALENDAR_CONNECTOR_ID=
OPENAI_GMAIL_CONNECTOR_ID=
OPENAI_GOOGLE_DRIVE_CONNECTOR_ID=

OZ_TIMEZONE=Asia/Tokyo
